      "guardian_hero": "https://images.unsplash.com/photo-1767858898311-b827bd68e2b5?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NDk1Nzl8MHwxfHNlYXJjaHwyfHxmYW1pbHklMjBjYXJpbmclMjBob21lfGVufDB8fHx8MTc3MDkyNzQ3N3ww&ixlib=rb-4.1.0&q=85",
      "device_hero": "https://images.unsplash.com/photo-1767903622388-4949aad2bd93?crop=entropy&cs=srgb&fm=jpg&ixid=M3w4NjY2NjV8MHwxfHNlYXJjaHwyfHxzbWFydCUyMHdhdGNoJTIwaGVhbHRoJTIwdHJhY2tlciUyMHdyaXN0fGVufDB8fHx8MTc3MDkyNzQ4MHww&ixlib=rb-4.1.0&q=85"
    }
  },
  "instructions_to_main_agent": [
    "TECH STACK: This is a React Native Expo project. Use <View>, <Text>, <Pressable>, NOT <div>, <span>, <button>.",
    "STYLING: Use StyleSheet.create(). Do not use className='...'.",
    "ICONS: Use @expo/vector-icons (Ionicons, MaterialCommunityIcons).",
    "THEME: Implement a ThemeContext to toggle between 'light' and 'dark' using the colors defined in this file.",
    "NAVIGATION: Use Expo Router (app/ directory).",
    "CHARTS: Use react-native-chart-kit for health data.",
    "DATA: Mock all data for now, but structure it realistically (e.g., heart rate array for graph).",
    "ACCESSIBILITY: Ensure all text is readable. Use `accessibilityLabel` on buttons.",
    "TESTING: Add `testID` prop to all interactive elements."
  ],
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "Do not use gradients for text to ensure readability.",
    "Use generous padding (minimum 16px) inside cards.",
    "Avoid centering text in long paragraphs; left align is better for readability.",
    "Use 'Pressable' with a visual feedback (opacity change) for all buttons.",
    "Ensure the SOS button is the most prominent element on the Beneficiary Dashboard."
  ]
}