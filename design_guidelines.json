{
  "identity": {
    "name": "CHUTEX",
    "vibe": "Futuristic Clinical",
    "core_principles": [
      "Clarity First: Vital signs must be legible at a glance.",
      "Reassurance: Design should feel safe and professional.",
      "Premium Tech: Use glassmorphism and subtle gradients to elevate beyond basic medical apps.",
      "Accessibility: High contrast and large touch targets for elderly users."
    ]
  },
  "typography": {
    "font_family_headings": "System",
    "font_family_body": "System",
    "scale": {
      "h1": { "size": 32, "lineHeight": 40, "weight": "700", "letterSpacing": -0.5 },
      "h2": { "size": 24, "lineHeight": 32, "weight": "600", "letterSpacing": -0.25 },
      "h3": { "size": 20, "lineHeight": 28, "weight": "600" },
      "body_lg": { "size": 18, "lineHeight": 28, "weight": "400" },
      "body_md": { "size": 16, "lineHeight": 24, "weight": "400" },
      "body_sm": { "size": 14, "lineHeight": 20, "weight": "400" },
      "caption": { "size": 12, "lineHeight": 16, "weight": "500", "textTransform": "uppercase" }
    }
  },
  "colors": {
    "light": {
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "surface_highlight": "#F1F5F9",
      "text_primary": "#0F172A",
      "text_secondary": "#475569",
      "text_muted": "#94A3B8",
      "primary": "#0891B2",
      "primary_foreground": "#FFFFFF",
      "secondary": "#E2E8F0",
      "accent": "#06B6D4",
      "border": "#E2E8F0",
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "info": "#3B82F6"
    },
    "dark": {
      "background": "#0B1120",
      "surface": "#1E293B",
      "surface_highlight": "#334155",
      "text_primary": "#F8FAFC",
      "text_secondary": "#CBD5E1",
      "text_muted": "#64748B",
      "primary": "#06B6D4",
      "primary_foreground": "#000000",
      "secondary": "#1E293B",
      "accent": "#22D3EE",
      "border": "#334155",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "info": "#60A5FA"
    },
    "gradients": {
      "primary_linear": ["#0891B2", "#06B6D4"],
      "sos_pulse": ["#EF4444", "#DC2626"]
    }
  },
  "layout_system": {
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "xxl": 48
    },
    "radius": {
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "full": 9999
    },
    "shadows": {
      "small": {
        "shadowColor": "#000",
        "shadowOffset": { "width": 0, "height": 1 },
        "shadowOpacity": 0.05,
        "shadowRadius": 2,
        "elevation": 2
      },
      "medium": {
        "shadowColor": "#000",
        "shadowOffset": { "width": 0, "height": 4 },
        "shadowOpacity": 0.1,
        "shadowRadius": 6,
        "elevation": 4
      },
      "glow": {
        "shadowColor": "#06B6D4",
        "shadowOffset": { "width": 0, "height": 0 },
        "shadowOpacity": 0.3,
        "shadowRadius": 10,
        "elevation": 6
      }
    }
  },
  "components": {
    "buttons": {
      "primary": {
        "borderRadius": 9999,
        "paddingVertical": 16,
        "paddingHorizontal": 32,
        "backgroundColor": "primary",
        "alignItems": "center",
        "justifyContent": "center"
      },
      "outline": {
        "borderRadius": 9999,
        "paddingVertical": 16,
        "paddingHorizontal": 32,
        "borderWidth": 1,
        "borderColor": "border",
        "backgroundColor": "transparent"
      }
    },
    "cards": {
      "base": {
        "backgroundColor": "surface",
        "borderRadius": 16,
        "padding": 24,
        "shadow": "medium"
      },
      "glass": {
        "backgroundColor": "rgba(255, 255, 255, 0.1)",
        "borderRadius": 16,
        "borderWidth": 1,
        "borderColor": "rgba(255, 255, 255, 0.2)"
      }
    }
  },
  "motion": {
    "transitions": {
      "fast": 200,
      "normal": 300,
      "slow": 500
    },
    "types": ["LayoutAnimation", "Reanimated.SharedTransition"]
  },
