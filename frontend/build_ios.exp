#!/usr/bin/expect -f
set timeout 300

spawn env EXPO_TOKEN=bSAaETVb2wyb8CdjB0KYCDDUjvk3yfEeEalSuAZh \
  EXPO_APPLE_ID=contact@chutex-innovation.com \
  EXPO_APPLE_PASSWORD=ggbf-lklb-lgrw-jytk \
  EXPO_APPLE_TEAM_ID=94YZY663N2 \
  npx eas-cli build --platform ios --profile production

expect {
    "What would you like to do?" {
        send "\r"
        exp_continue
    }
    "Do you want to log in to your Apple account?" {
        send "Y\r"
        exp_continue
    }
    "Would you like to try again?" {
        send "yes\r"
        exp_continue
    }
    "Generate a new" {
        send "\r"
        exp_continue
    }
    "Would you like to set up" {
        send "\r"
        exp_continue
    }
    "Select" {
        send "\r"
        exp_continue
    }
    "(Y/n)" {
        send "Y\r"
        exp_continue
    }
    "(y/N)" {
        send "y\r"
        exp_continue
    }
    "Would you like to" {
        send "y\r"
        exp_continue
    }
    -re "\\?" {
        send "\r"
        exp_continue
    }
    "Build details" {
        puts "\n=== BUILD SUBMITTED ==="
        exp_continue
    }
    eof {
        puts "\n=== DONE ==="
    }
    timeout {
        puts "\n=== TIMEOUT ==="
    }
}
