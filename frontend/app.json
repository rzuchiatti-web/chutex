{
  "expo": {
    "name": "Chutex Health",
    "slug": "chutex",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chutex",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "chutex",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chutex.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Chutex utilise le Bluetooth pour se connecter a votre bracelet et gilet anti-chute.",
        "NSBluetoothPeripheralUsageDescription": "Chutex utilise le Bluetooth pour se connecter a vos appareils de sante.",
        "NSFaceIDUsageDescription": "Chutex utilise Face ID pour une connexion securisee a votre espace sante.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "54"
    },
    "android": {
      "package": "com.chutex.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "react-native-ble-plx",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#111827"
        }
      ],
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6095040a-fe78-4b71-ae8f-bd1d82f93ef3"
      }
    }
  }
}
