#!/usr/bin/expect -f
set timeout 120

spawn env \
  EXPO_TOKEN=bSAaETVb2wyb8CdjB0KYCDDUjvk3yfEeEalSuAZh \
  EXPO_ASC_API_KEY_PATH=/app/frontend/keys/AuthKey_Y782NVC834.p8 \
  EXPO_ASC_KEY_ID=Y782NVC834 \
  EXPO_ASC_ISSUER_ID=dispatch-hub-164 \
  EXPO_APPLE_TEAM_ID=94YZY663N2 \
  eas credentials --platform ios

set log_file [open "/tmp/eas_cred_debug.log" w]

expect {
    -re "build profile" {
        puts $log_file "GOT: build profile prompt"
        sleep 1
        send "\r"
        exp_continue
    }
    -re "log in to your Apple" {
        puts $log_file "GOT: Apple login prompt"
        sleep 1
        send "Y\r"
        exp_continue
    }
    -re "authenticate with Apple" {
        puts $log_file "GOT: auth method"
        sleep 1
        # Choose API Key option (second option)
        send "\033\[B\r"
        exp_continue
    }
    -re "API Key path" {
        puts $log_file "GOT: API key path"
        send "/app/frontend/keys/AuthKey_Y782NVC834.p8\r"
        exp_continue
    }
    -re "Key ID" {
        puts $log_file "GOT: Key ID"
        send "Y782NVC834\r"
        exp_continue
    }
    -re "Issuer ID" {
        puts $log_file "GOT: Issuer ID"
        send "4c54dcaa-4ea0-4b6a-97b6-dce1c7fac20f\r"
        exp_continue
    }
    -re "Apple Team" {
        puts $log_file "GOT: Apple Team"
        send "94YZY663N2\r"
        exp_continue
    }
    -re "Set up" {
        puts $log_file "GOT: Set up prompt"
        sleep 1
        send "\r"
        exp_continue
    }
    -re "Generate" {
        puts $log_file "GOT: Generate prompt"
        sleep 1
        send "\r"
        exp_continue
    }
    -re "Use arrow" {
        puts $log_file "GOT: arrow keys prompt"
        sleep 1
        send "\r"
        exp_continue
    }
    -re "\\(Y/n\\)" {
        puts $log_file "GOT: Y/n"
        send "Y\r"
        exp_continue
    }
    -re "\\(y/N\\)" {
        puts $log_file "GOT: y/N"
        send "y\r"
        exp_continue
    }
    -re "Would you like" {
        puts $log_file "GOT: would you like"
        send "\r"
        exp_continue
    }
    -re "Reuse" {
        puts $log_file "GOT: reuse"
        send "\r"
        exp_continue
    }
    -re "\\?" {
        puts $log_file "GOT: question mark"
        send "\r"
        exp_continue
    }
    eof {
        puts $log_file "GOT: EOF"
        puts "\n=== CREDENTIALS DONE ==="
    }
    timeout {
        puts $log_file "GOT: TIMEOUT"
        puts "\n=== TIMEOUT ==="
    }
}

close $log_file
